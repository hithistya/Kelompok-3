# ===== 1. Pengguna (role: admin, petugas, pelapor) =====
HSET pengguna:1 id_pengguna 1 nama "Admin Sistem" email admin@contoh.id password PLACEHOLDER_HASH role admin
HSET pengguna:2 id_pengguna 2 nama "Petugas Satu" email petugas@contoh.id password PLACEHOLDER_HASH role petugas
HSET pengguna:3 id_pengguna 3 nama "Pelapor Satu" email pelapor1@contoh.id password PLACEHOLDER_HASH role pelapor
HSET pengguna:4 id_pengguna 4 nama "Pelapor Dua" email pelapor2@contoh.id password PLACEHOLDER_HASH role pelapor
SETNX pengguna:email:admin@contoh.id 1
SETNX pengguna:email:petugas@contoh.id 2
SETNX pengguna:email:pelapor1@contoh.id 3
SETNX pengguna:email:pelapor2@contoh.id 4
SADD pengguna:idx:role:admin 1
SADD pengguna:idx:role:petugas 2
SADD pengguna:idx:role:pelapor 3 4
SET seq:pengguna 4

